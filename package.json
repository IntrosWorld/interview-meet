{
  "name": "interview-meet",
  "version": "1.0.0",
  "description": "Interview Meet - voice and coding interview practice",
  "main": "server.ts",
  "scripts": {
    "local": "node scripts/local-launcher.mjs",
    "local:server": "tsx src/local-server.ts",
    "local:bench": "node scripts/benchmark-local.mjs",
    "local:test": "playwright test -c playwright.local.config.ts",
    "local:typecheck": "tsc --noEmit --types node --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck src/local-server.ts",
    "assets": "node scripts/sync-assets.mjs",
    "test": "playwright test",
    "start": "tsx server.ts",
    "dev": "tsx --watch --env-file=.env server.ts",
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck server.ts"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^1.30.0",
    "@hono/node-server": "^1.13.7",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/web": "^2.1.2",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.10.0",
    "hono": "^4.6.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
